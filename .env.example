# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: which OpenRouter model to use — must support OpenAI-style tool/function calling.
# Defaults to anthropic/claude-3.5-sonnet if unset.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: used in the OpenRouter HTTP-Referer header, cosmetic only
SITE_URL=https://d365finance.uk
